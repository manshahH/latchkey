# Local PostgreSQL connection used by the API and worker.
LATCHKEY_DATABASE_URL=postgresql://latchkey:latchkey@127.0.0.1:15432/latchkey

# Generate a unique value with at least 32 characters. Never commit the real value.
LATCHKEY_SESSION_SECRET=replace-with-a-unique-secret-that-is-at-least-32-characters

# Use development locally. Staging and production have separate values.
NODE_ENV=development

# GitHub App credentials for local M3 testing. Keep the PEM file in .secrets and never commit it.
LATCHKEY_GITHUB_APP_ID=replace-with-your-github-app-id
LATCHKEY_GITHUB_PRIVATE_KEY_PATH=.secrets/github-app.pem
LATCHKEY_GITHUB_WEBHOOK_SECRET=replace-with-a-unique-webhook-secret-at-least-32-characters
# Optional, disposable GitHub App live-contract test settings. Do not use a production organization or user.
LATCHKEY_GITHUB_LIVE_ORGANIZATION=replace-with-disposable-organization
LATCHKEY_GITHUB_LIVE_TEAM=replace-with-disposable-team
LATCHKEY_GITHUB_LIVE_USER_ID=replace-with-pre-existing-member-numeric-id
LATCHKEY_GITHUB_LIVE_INVITEE_ID=replace-with-external-test-user-numeric-id
LATCHKEY_GITHUB_LIVE_INVITEE_LOGIN=replace-with-external-test-user-login
# Private Cloudflare R2 bucket for seller exports. Store real values only in deployment secrets or .env.local.
LATCHKEY_R2_ACCOUNT_ID=29f3f502c63158e7a82f2c3e89a49d94
LATCHKEY_R2_BUCKET=latchkey-exports
LATCHKEY_R2_ACCESS_KEY_ID=replace-with-a-bucket-scoped-r2-access-key
LATCHKEY_R2_SECRET_ACCESS_KEY=replace-with-a-bucket-scoped-r2-secret

# Supabase provides this Postgres connection string. Use the direct connection for migrations,
# then the session pooler connection for the long-running API and worker services.
# LATCHKEY_DATABASE_URL=postgresql://postgres.<project-ref>:replace-with-password@aws-<region>.pooler.supabase.com:6543/postgres

# A base64url-encoded 32-byte application encryption key. Keep it only as a Cloudflare secret.
LATCHKEY_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
# Hosted containers receive the GitHub App PEM directly as a secret, never as a checked-in file.
LATCHKEY_GITHUB_PRIVATE_KEY=replace-with-the-full-github-app-pem
LATCHKEY_GITHUB_OAUTH_CLIENT_ID=replace-with-github-app-client-id
LATCHKEY_GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-app-client-secret

# Billing for Latchkey itself. Off during the free private beta (D-033). When false, the four
# Paddle values below are ignored and the platform billing webhook route does not exist.
# Set to true only after an owner-approved billing launch; then all four Paddle values are required.
# These are Paddle catalog price IDs, not a seller's connection settings.
LATCHKEY_PLATFORM_BILLING_ENABLED=false
LATCHKEY_PADDLE_PLATFORM_WEBHOOK_SECRET=replace-with-a-unique-webhook-secret-at-least-32-characters
LATCHKEY_PADDLE_PRICE_STARTER=replace-with-paddle-starter-price-id
LATCHKEY_PADDLE_PRICE_PRO=replace-with-paddle-pro-price-id
LATCHKEY_PADDLE_PRICE_SCALE=replace-with-paddle-scale-price-id

# Required before sending real buyer email. Use a verified sending domain.
LATCHKEY_RESEND_API_KEY=replace-with-resend-api-key
LATCHKEY_EMAIL_FROM=Latchkey <access@replace-with-your-domain>

# The public HTTPS origin, used in OAuth and claim links. Plain http://localhost is accepted only
# when NODE_ENV is not production, for running the stack on a developer machine.
LATCHKEY_PUBLIC_BASE_URL=https://replace-with-your-domain