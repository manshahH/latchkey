# Local PostgreSQL connection used by the API and worker.
LATCHKEY_DATABASE_URL=postgresql://latchkey:latchkey@127.0.0.1:15432/latchkey

# Generate a unique value with at least 32 characters. Never commit the real value.
LATCHKEY_SESSION_SECRET=replace-with-a-unique-secret-that-is-at-least-32-characters

# Use development locally. Staging and production have separate values.
NODE_ENV=development

# GitHub App credentials for local M3 testing. Keep the PEM file in .secrets and never commit it.
LATCHKEY_GITHUB_APP_ID=replace-with-your-github-app-id
LATCHKEY_GITHUB_PRIVATE_KEY_PATH=.secrets/github-app.pem
LATCHKEY_GITHUB_WEBHOOK_SECRET=replace-with-a-unique-webhook-secret-at-least-32-characters
# Optional, disposable GitHub App live-contract test settings. Do not use a production organization or user.
LATCHKEY_GITHUB_LIVE_ORGANIZATION=replace-with-disposable-organization
LATCHKEY_GITHUB_LIVE_TEAM=replace-with-disposable-team
LATCHKEY_GITHUB_LIVE_USER_ID=replace-with-pre-existing-member-numeric-id
LATCHKEY_GITHUB_LIVE_INVITEE_ID=replace-with-external-test-user-numeric-id
LATCHKEY_GITHUB_LIVE_INVITEE_LOGIN=replace-with-external-test-user-login