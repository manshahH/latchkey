# Local PostgreSQL connection used by the API and worker.
LATCHKEY_DATABASE_URL=postgresql://latchkey:latchkey@localhost:5432/latchkey

# Generate a unique value with at least 32 characters. Never commit the real value.
LATCHKEY_SESSION_SECRET=replace-with-a-unique-secret-that-is-at-least-32-characters

# Use development locally. Staging and production have separate values.
NODE_ENV=development
